<Window x:Class="filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:filmek"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="600">
    <Grid Margin="20">
        <ListBox x:Name="lbAdatok" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,45,280,0" SelectionChanged="lbAdatok_SelectionChanged" VerticalAlignment="Top" Background="#F4F4F4" BorderBrush="#D3D3D3" BorderThickness="1" />
        <Button Content="Lekérdez" HorizontalAlignment="Left" Margin="0,0,0,10" VerticalAlignment="Top" Width="120" Click="Button_Click" Background="#0078D4" Foreground="White" BorderBrush="Transparent"/>
        <Label x:Name="lbFilmAzon" Content="-" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="296,0,0,0" FontSize="14" Height="29" Width="120" RenderTransformOrigin="0.5,0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="1.548"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.473"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,10,0">
            <TextBox x:Name="tb1" Width="120" BorderBrush="#D3D3D3" BorderThickness="1" Background="#F4F4F4" Padding="5" Margin="0,0,0,10"/>
            <TextBox x:Name="tb2" Width="120" BorderBrush="#D3D3D3" BorderThickness="1" Background="#F4F4F4" Padding="5" Margin="0,0,0,10"/>
            <TextBox x:Name="tb3" Width="120" BorderBrush="#D3D3D3" BorderThickness="1" Background="#F4F4F4" Padding="5" Margin="0,0,0,10"/>
            <TextBox x:Name="tb4" Width="120" BorderBrush="#D3D3D3" BorderThickness="1" Background="#F4F4F4" Padding="5" Margin="0,0,0,10"/>
            <TextBox x:Name="tb5" Width="120" BorderBrush="#D3D3D3" BorderThickness="1" Background="#F4F4F4" Padding="5" Margin="0,0,0,10"/>
        </StackPanel>
        <Button Content="Módosít" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Click="Button_Click_1" Background="#0078D4" Foreground="White" BorderBrush="Transparent" Margin="0,20,0,0"/>
    </Grid>
</Window>
